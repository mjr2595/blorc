---
import { decodeHTML } from "entities";
import type { Article } from "../lib/aggregate";
import { getArticles } from "../lib/aggregate";
import "../styles/global.css";

export const prerender = false;

// Set cache control headers to ensure fresh data on each request
if (Astro.response) {
  Astro.response.headers.set(
    "Cache-Control",
    "no-cache, no-store, must-revalidate"
  );
  Astro.response.headers.set("Pragma", "no-cache");
  Astro.response.headers.set("Expires", "0");
}

let articles: Article[] = [];
let error: Error | null = null;

try {
  articles = await getArticles();
} catch (e) {
  console.error("Error fetching articles:", e);
  error = e instanceof Error ? e : new Error(String(e));
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blorc</title>
    <meta
      name="description"
      content="Latest blog posts from Torc community members"
    />
    <link rel="icon" href="https://fav.farm/🔥" />
    <link rel="canonical" href="/" />
  </head>
  <body>
    <header>
      <div class="header-main">
        <img src="/images/torc-logo.png" alt="Torc Logo" class="logo" />
        <h1>Latest Blog Posts from Torc Community Members</h1>
      </div>
      <nav>
        <a href="/bloggers">Blogger Directory</a>
      </nav>
    </header>

    <main>
      {
        error ? (
          <div class="error-message">
            <p>Error loading articles. Please try refreshing the page.</p>
            <p>
              <small>
                Last updated:{" "}
                {new Date().toLocaleDateString("en-GB", {
                  day: "numeric",
                  month: "long",
                  year: "numeric",
                  hour: "numeric",
                  minute: "numeric",
                  hour12: true,
                  timeZoneName: "shortGeneric",
                })}
              </small>
            </p>
          </div>
        ) : articles.length > 0 ? (
          <>
            <div class="update-info">
              <p>
                <small>
                  Last updated:{" "}
                  {new Date().toLocaleDateString("en-GB", {
                    day: "numeric",
                    month: "long",
                    year: "numeric",
                    hour: "numeric",
                    minute: "numeric",
                    hour12: true,
                    timeZoneName: "shortGeneric",
                  })}
                </small>
              </p>
            </div>
            <ol class="article-list">
              {articles.map((article) => (
                <li class="article-item">
                  <h2 class="article-title">
                    <a
                      href={article.link}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {decodeHTML(article.title)}
                    </a>
                  </h2>
                  <div class="article-meta">
                    By{" "}
                    <a
                      href={article.writerSite}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {decodeHTML(article.writerName)}
                    </a>{" "}
                    — {decodeHTML(article.channelTitle ?? "")} •{" "}
                    {new Date(article.published).toLocaleDateString("en-GB", {
                      day: "numeric",
                      month: "long",
                      year: "numeric",
                    })}
                  </div>
                  {article.summary && (
                    <p class="article-summary">
                      {decodeHTML(
                        article.summary.replace(/<[^>]*>/g, "")
                      ).slice(0, 200)}
                      ...
                    </p>
                  )}
                </li>
              ))}
            </ol>
          </>
        ) : (
          <div class="no-articles">
            <p>No articles found. Please try again later.</p>
            <p>
              <small>
                Last checked:{" "}
                {new Date().toLocaleDateString("en-GB", {
                  day: "numeric",
                  month: "long",
                  year: "numeric",
                  hour: "numeric",
                  minute: "numeric",
                  hour12: true,
                  timeZoneName: "short",
                })}
              </small>
            </p>
          </div>
        )
      }
    </main>

    <footer>
      <p>
        <a
          href="https://www.torc.dev/community/"
          target="_blank"
          rel="noopener noreferrer">Torc Community Page</a
        >
        •
        <a
          href="https://github.com/mjr2595/blorc"
          target="_blank"
          rel="noopener noreferrer">GitHub</a
        >
      </p>
    </footer>
  </body>
</html>
